Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass HTTPS flag to mod_headers reliably on Apache and LiteSpeed
  RewriteCond %{HTTPS} =on
  RewriteRule ^ - [E=HTTPS:on]

  # Redirect /index.html and /index.htm -> https://caraguapixel.online/ (loop-safe via THE_REQUEST)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html?(\?[^\ ]*)?\ HTTP/ [NC]
  RewriteRule ^index\.html?$ https://caraguapixel.online/ [R=301,L,NC]

  # Redirect legacy /jogo.html -> https://caraguapixel.online/
  RewriteRule ^jogo\.html$ https://caraguapixel.online/ [R=301,L,NC]

  # Force HTTPS and canonical non-www host in a single 301 hop
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.caraguapixel\.online(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://caraguapixel.online/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^(admin|mapa-original)\.html$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml image/x-icon image/vnd.microsoft.icon
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

<FilesMatch "\.(css|js|ico)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000"
  </IfModule>
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000"
  </IfModule>
</FilesMatch>
